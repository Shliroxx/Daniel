# Kopiere diese Datei zu ".env" und trage deinen Key ein.

# Anthropic API Key (https://console.anthropic.com) — das "Gehirn" von Jarvis
ANTHROPIC_API_KEY=sk-ant-...

# Modell + wie gruendlich Jarvis nachdenkt (low = schnell, high = klug)
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium

# Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# Sprache
JARVIS_LANGUAGE=de
JARVIS_WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
JARVIS_WHISPER_DEVICE=auto          # auto | cpu | cuda
JARVIS_WAKEWORD=hey_jarvis
JARVIS_WAKEWORD_THRESHOLD=0.5
JARVIS_MIC_ENABLED=true             # Wake-Word-Dauerbetrieb am PC-Mikrofon
JARVIS_SPEAK_LOCALLY=true           # Antwort ueber die PC-Lautsprecher ausgeben

# Piper-Stimme (deutsch). Wird beim ersten Start automatisch heruntergeladen.
JARVIS_PIPER_VOICE=de_DE-thorsten-high

# Arbeitsverzeichnis: nur hier darf Jarvis Dateien lesen/schreiben
JARVIS_WORKSPACE=./workspace

# Gefaehrliche Faehigkeiten (Standard: aus)
JARVIS_ALLOW_SHELL=false            # beliebige Shell-Befehle ausfuehren
