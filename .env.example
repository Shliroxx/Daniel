# Kopiere diese Datei zu ".env" und passe sie an.

# ============================================================
#  DENKAPPARAT
# ============================================================
# cli = läuft über die Claude-Code-CLI und damit über dein Claude-Abo.
#       Keine Token-Kosten. Braucht Node.js und ein Claude-Pro- oder Max-Abo.
#       Einmalig:  npm install -g @anthropic-ai/claude-code   und dann  claude  (anmelden)
# api = läuft über die Anthropic-API mit eigenem Key. Kostet pro Token.
JARVIS_BACKEND=cli

# --- nur für BACKEND=cli ---
JARVIS_CLI_MODEL=sonnet          # sonnet | opus | haiku
# JARVIS_CLAUDE_BIN=claude       # nur nötig, wenn "claude" nicht im PATH liegt
JARVIS_CLI_TIMEOUT=300           # Sekunden pro Antwort
JARVIS_CLI_MAX_TURNS=24          # Sicherheitsnetz gegen Endlosschleifen

# --- nur für BACKEND=api ---
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium             # low = schnell, high = klug

# ============================================================
#  SERVER
# ============================================================
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8765

# ============================================================
#  SPRACHE (läuft komplett offline)
# ============================================================
JARVIS_LANGUAGE=de
JARVIS_WHISPER_MODEL=small       # tiny | base | small | medium | large-v3
JARVIS_WHISPER_DEVICE=auto       # auto | cpu | cuda
JARVIS_WAKEWORD=hey_jarvis
JARVIS_WAKEWORD_THRESHOLD=0.5    # niedriger = löst leichter aus
JARVIS_MIC_ENABLED=true          # Wake-Word-Dauerbetrieb am PC-Mikrofon
JARVIS_SPEAK_LOCALLY=true        # Antwort über die PC-Lautsprecher ausgeben

# Piper-Stimme (deutsch). Wird beim ersten Start automatisch heruntergeladen.
JARVIS_PIPER_VOICE=de_DE-thorsten-high

# ============================================================
#  OBSIDIAN — Gedächtnis, Aufgaben, Protokoll
# ============================================================
JARVIS_VAULT_ENABLED=true
JARVIS_VAULT=~/Obsidian          # Pfad zu deinem Vault
JARVIS_MEMORY_DIR=jarvis         # Unterordner darin, den Jarvis verwaltet
# Ohne Vault legt Jarvis dieselben Dateien im data-Ordner ab.

# ============================================================
#  WHATSAPP (offizielle Meta Cloud API)
# ============================================================
# Einrichtung siehe README. Ohne öffentlich erreichbaren HTTPS-Webhook geht es nicht.
JARVIS_WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=                          # Zugriffstoken aus der Meta-App
WHATSAPP_PHONE_NUMBER_ID=                # ID der Absendernummer
WHATSAPP_VERIFY_TOKEN=                   # frei wählbar, muss bei Meta gleich eingetragen sein
WHATSAPP_APP_SECRET=                     # App-Secret — ohne das wird die Signatur NICHT geprüft
WHATSAPP_ALLOWED_NUMBERS=                # deine Nummer(n), Komma-getrennt, z. B. 4915112345678
WHATSAPP_VOICE_REPLY=false               # Antwort zusätzlich als Sprachnachricht (braucht ffmpeg)

# ============================================================
#  SHISHA-ANALYZER (AR-Kamera fürs iPhone)
# ============================================================
SHISHA_ENABLED=true
# Leer lassen = dasselbe Backend wie Jarvis. "cli" nutzt dein Claude-Abo,
# "api" die Anthropic-API mit Key (schneller, kostet pro Bild).
SHISHA_BACKEND=
SHISHA_MODEL=claude-sonnet-5     # Vision-Modell bei SHISHA_BACKEND=api
SHISHA_CLI_MODEL=sonnet          # Modell bei SHISHA_BACKEND=cli
SHISHA_PORT=8443                 # eigener Port für "python -m shisha"
SHISHA_TLS=true                  # HTTPS — ohne das gibt Safari die Kamera nicht frei
SHISHA_MAX_KANTE=768             # Kamerabilder werden vorher auf diese Kante geschrumpft
SHISHA_QUALITAET=80              # JPEG-Qualität der Analysebilder
SHISHA_VERLAUF=12                # so viele Analysen bleiben als Kontext erhalten

# ============================================================
#  DATEIEN UND RECHTE
# ============================================================
JARVIS_WORKSPACE=./workspace     # nur hier darf Jarvis frei Dateien lesen/schreiben
JARVIS_ALLOW_SHELL=false         # beliebige Shell-Befehle ausführen — mit Bedacht
