	"authors": [
		"SANTIQ"
	],
	"license": "MIT",
	"icon": "assets/kingdomomnitrix/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.santiq.kingdomomnitrix.KingdomOmnitrix"
		],
		"client": [
			"com.santiq.kingdomomnitrix.client.KingdomOmnitrixClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.0",
		"geckolib": ">=4.9.0",
		"playeranimator": ">=2.0.0"
	},
	"mixins": [
		"kingdomomnitrix.mixins.json",
		{
			"config": "kingdomomnitrix.client.mixins.json",
			"environment": "client"
		}
	]
